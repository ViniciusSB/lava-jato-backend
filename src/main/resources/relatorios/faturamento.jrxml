	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="lavajato"/>
	<style name="Title" fontName="SansSerif" fontSize="26.0" bold="true"/>
	<style name="SubTitle" forecolor="#666666" fontName="SansSerif" fontSize="18.0"/>
