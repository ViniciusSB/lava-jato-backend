		<property name="com.jaspersoft.studio.field.label" value="lavagens"/>
	</field>
	<field name="total_liquido" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="total_liquido"/>
		<property name="com.jaspersoft.studio.field.label" value="total_liquido"/>
	</field>
	<field name="ultima_lavagem_concluida" class="java.time.LocalDateTime">
		<property name="com.jaspersoft.studio.field.name" value="ultima_lavagem_concluida"/>
		<property name="com.jaspersoft.studio.field.label" value="ultima_lavagem_concluida"/>
	</field>
	<variable name="Somar_total_liquido" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_liquido}]]></expression>
	</variable>
	<variable name="Hora" class="java.lang.String">
		<expression><![CDATA[$F{ultima_lavagem_concluida}.toString().split("T")[1].substring(0,5)]]></expression>
	</variable>
	<variable name="Data" class="java.lang.String">
		<expression><![CDATA[$F{ultima_lavagem_concluida}.toString().split("T")[0]]]></expression>
	</variable>
