	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="lavajato"/>
	<style name="Title" fontName="SansSerif" fontSize="26.0" bold="true"/>
	<style name="SubTitle" forecolor="#666666" fontName="SansSerif" fontSize="18.0"/>
	<style name="Column header" forecolor="#FFFFFF" fontName="SansSerif" fontSize="12.0" bold="true"/>
	<style name="Detail" fontName="SansSerif" fontSize="12.0"/>
	<query language="SQL"><![CDATA[SELECT u.nome,
	u.email,
	COUNT( os.id) AS servicos_finalizados,
	SUM( f.valor_bruto) AS total_bruto,
	SUM( f.valor_liquido) AS total_liquido,
	SUM( f.taxa_funcionario) AS total_funcionario,
	MAX( os.data_atualizacao) AS ultimo_servico_finalizado
FROM usuario u
	LEFT JOIN ordem_servico os ON 
	 u.id = os.funcionario_id 
	 AND os.status = 'FINALIZADO' 
	LEFT JOIN faturamento f ON 
	 f.ordem_servico_id = os.id 
WHERE 
	 u.tipo_usuario = 'FUNCIONARIO' 
GROUP BY u.id,
	u.nome,
	u.email
ORDER BY u.id ASC]]></query>
