	<parameter name="usuarioId" class="java.lang.Long"/>
	<query language="sql"><![CDATA[SELECT u.nome AS nome,
    c.nome AS cliente,
	v.tipo AS veiculo,
	s.tipo AS servico,
	f.taxa_funcionario AS faturamento,
	os.data_criacao AS inicio,
	f.data_criacao AS finalizado_em
FROM usuario u
	INNER JOIN ordem_servico os ON 
	 u.id = os.funcionario_id 
	 AND os.status = 'FINALIZADO' 
	INNER JOIN servico s ON 
	 s.id = os.servico_id 
	INNER JOIN veiculo v ON 
	 v.id = os.veiculo_id 
	INNER JOIN cliente c ON 
	 c.id = os.cliente_id 
	INNER JOIN faturamento f ON 
	 f.ordem_servico_id = os.id 
WHERE 
	 u.id = $P{usuarioId} 
ORDER BY f.data_criacao ASC]]></query>
